---
const base = import.meta.env.BASE_URL;
const links = [
  ["Articles", `${base}articles/`],
  ["Career", `${base}career/`],
  ["Projects", `${base}projects/`],
  ["Community", `${base}community/`],
  ["Thoughts", `${base}thoughts/`],
  ["About", `${base}about/`],
];
---
<header class="site-header">
  <div class="shell nav-shell">
    <a class="brand" href={base} aria-label="Surya Tech Codex home">
      <span class="brand-mark" aria-hidden="true">S/</span>
      <span><strong>Surya Tech</strong><small>CODEX</small></span>
    </a>
    <nav class="desktop-nav" aria-label="Primary navigation">
      {links.map(([label, href]) => <a href={href}>{label}</a>)}
    </nav>
    <a class="nav-cta" href={`${base}articles/`}>Explore notes <span aria-hidden="true">→</span></a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open navigation">
      <span></span><span></span>
    </button>
  </div>
  <nav class="mobile-nav" id="mobile-menu" aria-label="Mobile navigation" hidden>
    <div class="shell">
      {links.map(([label, href], index) => <a href={href}><span>0{index + 1}</span>{label}<b>↗</b></a>)}
    </div>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const menu = document.querySelector<HTMLElement>(".mobile-nav");
  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!open));
    toggle.setAttribute("aria-label", open ? "Open navigation" : "Close navigation");
    if (menu) menu.hidden = open;
    document.body.classList.toggle("menu-open", !open);
  });
</script>
