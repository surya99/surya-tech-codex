---
const base = import.meta.env.BASE_URL;
const links = [
  ["Articles", `${base}articles/`],
  ["Projects", `${base}projects/`],
  ["Career", `${base}career/`],
  ["About", `${base}about/`],
];
---
<header class="site-header">
  <div class="shell nav-shell">
    <a class="brand" href={base} aria-label="Surya Tech Codex home">
      <span class="brand-monogram" aria-hidden="true">S</span>
      <span class="brand-copy"><strong>SuryaKant</strong><small>TECH CODEX</small></span>
    </a>
    <nav class="desktop-nav" aria-label="Primary navigation">
      {links.map(([label, href]) => <a href={href}>{label}</a>)}
    </nav>
    <a class="header-follow" href={`${base}rss.xml`}><span aria-hidden="true">◉</span> Follow the journey</a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open navigation">
      <span></span><span></span>
    </button>
  </div>
  <nav class="mobile-nav" id="mobile-menu" aria-label="Mobile navigation" hidden>
    <div class="shell">
      {links.map(([label, href]) => <a href={href}>{label}<span>→</span></a>)}
      <a href={`${base}community/`}>Community <span>→</span></a>
      <a href={`${base}thoughts/`}>Thoughts <span>→</span></a>
    </div>
  </nav>
</header>

<script>
  const setupMenu = () => {
    const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
    const menu = document.querySelector<HTMLElement>(".mobile-nav");
    if (!toggle || !menu || toggle.dataset.ready) return;
    toggle.dataset.ready = "true";
    toggle.addEventListener("click", () => {
      const open = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", String(!open));
      toggle.setAttribute("aria-label", open ? "Open navigation" : "Close navigation");
      menu.hidden = open;
      document.body.classList.toggle("menu-open", !open);
    });
  };
  setupMenu();
  document.addEventListener("astro:page-load", setupMenu);
</script>
