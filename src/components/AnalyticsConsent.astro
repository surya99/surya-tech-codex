---
import { siteConfig } from "../config";

const measurementId = siteConfig.analytics.gaMeasurementId;
---

{measurementId && (
  <aside class="consent-banner" aria-labelledby="consent-title" hidden>
    <div>
      <strong id="consent-title">Your privacy, your choice</strong>
      <p>We use Google Analytics to understand which articles are useful. Analytics loads only if you accept. <a href={`${import.meta.env.BASE_URL}privacy/`}>Privacy details</a></p>
    </div>
    <div class="consent-actions">
      <button type="button" class="consent-decline" data-consent="denied">Decline</button>
      <button type="button" class="consent-accept" data-consent="granted">Accept analytics</button>
    </div>
  </aside>
)}

{measurementId && (
  <script is:inline define:vars={{ measurementId }}>
    (() => {
      if (window.__suryaConsentSetup) return;
      window.__suryaConsentSetup = true;
      const storageKey = "surya-tech-codex-analytics-consent";
      let analyticsLoaded = false;

      const getChoice = () => {
        try { return localStorage.getItem(storageKey); }
        catch { return null; }
      };
      const saveChoice = (choice) => {
        try { localStorage.setItem(storageKey, choice); }
        catch { /* The current visit still respects the selected choice. */ }
      };
      const loadAnalytics = () => {
        if (analyticsLoaded) return;
        analyticsLoaded = true;
        window.dataLayer = window.dataLayer || [];
        window.gtag = function(){ window.dataLayer.push(arguments); };
        window.gtag("js", new Date());
        window.gtag("consent", "default", {
          analytics_storage: "denied",
          ad_storage: "denied",
          ad_user_data: "denied",
          ad_personalization: "denied"
        });
        window.gtag("consent", "update", { analytics_storage: "granted" });
        window.gtag("config", measurementId, { send_page_view: false });
        const tag = document.createElement("script");
        tag.async = true;
        tag.src = `https://www.googletagmanager.com/gtag/js?id=${measurementId}`;
        document.head.appendChild(tag);
      };
      const trackPage = () => {
        if (getChoice() !== "granted") return;
        loadAnalytics();
        window.gtag("event", "page_view", {
          page_title: document.title,
          page_location: window.location.href,
          page_path: window.location.pathname
        });
      };
      const updateBanner = () => {
        const banner = document.querySelector(".consent-banner");
        if (banner) banner.hidden = getChoice() !== null;
      };

      document.addEventListener("click", (event) => {
        const preferenceButton = event.target.closest("[data-open-consent]");
        if (preferenceButton) {
          const banner = document.querySelector(".consent-banner");
          if (banner) banner.hidden = false;
          return;
        }
        const choiceButton = event.target.closest("[data-consent]");
        if (!choiceButton) return;
        const choice = choiceButton.dataset.consent;
        saveChoice(choice);
        updateBanner();
        if (choice === "granted") trackPage();
      });

      document.addEventListener("astro:page-load", () => {
        updateBanner();
        trackPage();
      });
      updateBanner();
    })();
  </script>
)}
