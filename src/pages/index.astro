---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { getReadingTime } from "../utils/readingTime";
import { videos } from "../data/videos";
const base = import.meta.env.BASE_URL;
const articles = (await getCollection("articles", ({ data }) => !data.draft)).sort((a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf());
const featured = articles[0];
---
<BaseLayout pageClass="home-v3 home-compact" description="Surya Tech Codex is a future-tech studio and knowledge platform for .NET, Azure, AI, practical engineering, products, and training.">
  <section class="future-hero compact-hero">
    <div class="future-grid" aria-hidden="true"></div><div class="future-glow glow-one" aria-hidden="true"></div><div class="future-glow glow-two" aria-hidden="true"></div>
    <div class="shell compact-hero-grid">
      <div class="compact-intro reveal">
        <div class="clean-console" aria-label="Introduction">
          <p class="console-hello">Hello<span>.</span></p>
          <h1>I’m <em>Suryakant.</em></h1>
          <p class="console-work"><span class="command-prompt">&gt;</span><strong id="command-text">I build with .NET</strong><i aria-hidden="true"></i></p>
        </div>
        <p class="brand-statement">Building technology. <em>Growing knowledge.</em> Creating impact.</p>
        <p class="future-summary">Surya Tech Codex brings together practical engineering, AI-powered products, community learning and professional training.</p>
        <div class="future-actions"><a class="future-button primary" href={`${base}projects/`}>Explore our work <span>→</span></a><a class="future-button ghost" href={`${base}training/`}>Learn with us <span>↗</span></a><a class="future-button connect-action" href={`${base}about/#connect`}>Connect with me <span>↗</span></a></div>
        <div class="future-proof"><span><b>10+</b><small>years engineering</small></span><span><b>.NET</b><small>product development</small></span><span><b>AI</b><small>future focused</small></span></div>
      </div>
      <div class="technology-system compact-system reveal reveal-delay" aria-label="Animated .NET, Azure and AI technology ecosystem">
        <div class="system-halo halo-a"></div><div class="system-halo halo-b"></div><div class="system-halo halo-c"></div>
        <div class="system-core"><span>&lt;S/&gt;</span><small>CODE SMARTER · GROW FASTER</small></div>
        <div class="orbit orbit-one"><span class="tech-node dotnet">.NET</span></div><div class="orbit orbit-two"><span class="tech-node azure">AZURE</span></div><div class="orbit orbit-three"><span class="tech-node ai">AI</span></div>
        <span class="signal signal-a"></span><span class="signal signal-b"></span><span class="signal signal-c"></span>
        <p class="system-caption"><span>● SYSTEM ONLINE</span> BUILD · LEARN · SHARE · GROW</p>
      </div>
    </div>
  </section>

  <section class="future-section signal-section compact-signals"><div class="shell">
    <header class="future-heading compact reveal"><div><span class="future-index">LATEST FROM SURYA TECH CODEX</span><h2>Fresh knowledge.<br /><em>Practical direction.</em></h2></div><p>One useful article and one recent video—everything else is available from the main menu.</p></header>
    <div class="signal-grid">
      {featured && <article class="latest-note reveal"><div class="signal-type"><span>LATEST ARTICLE</span><small>{featured.data.category}</small></div><h3><a href={`${base}articles/${featured.id}/`}>{featured.data.title}</a></h3><p>{featured.data.description}</p><footer><time>{featured.data.publishedDate.toLocaleDateString("en-GB", { day: "2-digit", month: "short", year: "numeric" })}</time><span>{featured.data.readingTime ?? getReadingTime(featured.body ?? "")}</span><a href={`${base}articles/${featured.id}/`}>Read article →</a></footer></article>}
      <div class="video-spotlight reveal" data-video-spotlight><div class="video-label"><span>RECENT ON YOUTUBE</span><small>VIDEO SPOTLIGHT</small></div><a class="video-stage" href={`${base}training/#videos`} aria-label="See videos on the Training page">{videos.map((video, index) => <article class:list={["video-slide", { active: index === 0 }]} data-slide={index}><img src={video.thumbnail} alt="" loading={index === 0 ? "eager" : "lazy"} /><span class="video-overlay"></span><i class="play-button">▶</i><div><small>{video.topic}</small><h3>{video.title}</h3><b>Explore video library →</b></div></article>)}</a><div class="video-controls">{videos.map((video, index) => <button class:list={[{ active: index === 0 }]} type="button" data-video-button={index} aria-label={`Show video ${index + 1}: ${video.title}`}><span>{String(index + 1).padStart(2, "0")}</span></button>)}</div></div>
    </div>
  </div></section>

  <section class="future-cta"><div class="shell reveal"><span>&lt;S/&gt;</span><p>BUILD · LEARN · SHARE · GROW</p><h2>The future is not something we wait for.<br /><em>It is something we build.</em></h2><div><a class="future-button primary" href={`${base}training/`}>Explore training <span>→</span></a><a class="future-button ghost" href="mailto:suryatechcodex@gmail.com">Start a conversation <span>↗</span></a></div></div></section>
</BaseLayout>

<script>
  const commands = ["I build with .NET", "I architect on Azure", "I create with AI", "I share practical knowledge", "I train engineers to grow"];
  const setupHome = () => {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const items = document.querySelectorAll<HTMLElement>(".reveal:not(.is-visible)");
    if (reduced) items.forEach((item) => item.classList.add("is-visible")); else { const observer = new IntersectionObserver((entries) => entries.forEach((entry) => { if (entry.isIntersecting) { entry.target.classList.add("is-visible"); observer.unobserve(entry.target); } }), { threshold: .12 }); items.forEach((item) => observer.observe(item)); }
    const command = document.querySelector<HTMLElement>("#command-text");
    if (command && !command.dataset.ready && !reduced) { command.dataset.ready = "true"; let n = 0; window.setInterval(() => { command.classList.add("changing"); window.setTimeout(() => { n = (n + 1) % commands.length; command.textContent = commands[n]; command.classList.remove("changing"); }, 220); }, 2600); }
    const spotlight = document.querySelector<HTMLElement>("[data-video-spotlight]");
    if (spotlight && !spotlight.dataset.ready) { spotlight.dataset.ready = "true"; const slides = [...spotlight.querySelectorAll<HTMLElement>("[data-slide]")]; const buttons = [...spotlight.querySelectorAll<HTMLButtonElement>("[data-video-button]")]; let active = 0; const show = (next: number) => { active = next; slides.forEach((slide, i) => slide.classList.toggle("active", i === active)); buttons.forEach((button, i) => button.classList.toggle("active", i === active)); }; buttons.forEach((button, i) => button.addEventListener("click", () => show(i))); if (!reduced) window.setInterval(() => show((active + 1) % slides.length), 6000); }
  };
  setupHome(); document.addEventListener("astro:page-load", setupHome);
</script>
