---
import BaseLayout from "../layouts/BaseLayout.astro";
import Subscribe from "../components/Subscribe.astro";
import { siteConfig } from "../config";
import { getCollection } from "astro:content";
import { getReadingTime } from "../utils/readingTime";

const base = import.meta.env.BASE_URL;
const articles = (await getCollection("articles", ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf());
const featured = articles[0];
const recent = articles.slice(1, 5);
---
<BaseLayout>
  <section class="personal-hero">
    <div class="shell personal-hero-grid">
      <div class="hero-introduction reveal">
        <p class="hello"><span>Hi, I’m</span> Suryakant.</p>
        <h1>I learn deeply, build practical software, and help others grow through <em>knowledge.</em></h1>
        <p class="hero-summary">I’m a .NET full-stack engineer and technical lead with 10+ years of experience. I share practical lessons through articles, community work, and training on .NET and Azure technologies.</p>
        <div class="terminal-identity" aria-label="Architecting with .NET, building with AI, and sharing practical knowledge">
          <span class="terminal-prompt" aria-hidden="true">~/surya $</span>
          <span class="terminal-cycle" aria-hidden="true">
            <span>architecting_with_dotnet</span>
            <span>building_with_ai</span>
            <span>sharing_practical_knowledge</span>
          </span>
          <i aria-hidden="true"></i>
        </div>
        <div class="hero-cta">
          <a class="button button-primary" href={featured ? `${base}articles/${featured.id}/` : `${base}articles/`}>Read my latest note <span>→</span></a>
          <a class="text-button dark-link" href={`${base}training/`}>Explore training ↗</a>
        </div>
        <div class="identity-points" aria-label="Professional focus">
          <span><b>10+</b> years in software</span>
          <span><b>.NET</b> engineering</span>
          <span><b>Training</b> .NET and Azure</span>
        </div>
      </div>
      <div class="portrait-stage reveal reveal-delay">
        <div class="portrait-shape"></div>
        <div class="tech-orbit" aria-hidden="true">
          <span class="orbit-ring"></span>
          <b class="orbit-node node-dotnet">.NET</b>
          <b class="orbit-node node-ai">AI</b>
          <b class="orbit-node node-azure">AZ</b>
        </div>
        <img src="https://avatars.githubusercontent.com/u/11807962?v=4" alt="Suryakant" width="460" height="460" />
        <a class="portrait-note note-top profile-note" href={siteConfig.linkedin} target="_blank" rel="noreferrer"><span class="linkedin-mark">in</span><span><small>LET'S CONNECT</small><strong>View LinkedIn profile ↗</strong></span></a>
        <div class="portrait-note note-bottom"><span class="live-dot"></span><strong>Learning and building in public</strong></div>
        <span class="portrait-code" aria-hidden="true">{ }</span>
      </div>
    </div>
  </section>

  <section class="verb-band" aria-label="What Suryakant does">
    <div class="verb-marquee">
      <div class="verb-track">
        <div class="verb-set">
          <span><b class="action-icon icon-learn" aria-hidden="true">◫</b>Learn</span>
          <span><b class="action-icon icon-share" aria-hidden="true">↗</b>Share</span>
          <span><b class="action-icon icon-write" aria-hidden="true">✎</b>Write</span>
          <span><b class="action-icon icon-train" aria-hidden="true">◎</b>Train</span>
        </div>
        <div class="verb-set" aria-hidden="true">
          <span><b class="action-icon icon-learn">◫</b>Learn</span>
          <span><b class="action-icon icon-share">↗</b>Share</span>
          <span><b class="action-icon icon-write">✎</b>Write</span>
          <span><b class="action-icon icon-train">◎</b>Train</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section writing-section shell reveal">
    <header class="editorial-heading">
      <div><span class="section-label">Latest writing</span><h2>Notes for engineers who care about the <em>why.</em></h2></div>
      <a href={`${base}articles/`} class="text-button dark-link">All articles →</a>
    </header>
    {featured && (
      <div class="writing-layout">
        <article class="featured-story">
          <div class="story-art" aria-hidden="true"><span>FIELD NOTE / 001</span><strong>SQL</strong><div></div></div>
          <div class="story-copy">
            <div class="article-meta"><span>{featured.data.category}</span><time>{featured.data.publishedDate.toLocaleDateString("en-GB", { day: "2-digit", month: "short", year: "numeric" })}</time><span>{featured.data.readingTime ?? getReadingTime(featured.body ?? "")}</span></div>
            <h3><a href={`${base}articles/${featured.id}/`}>{featured.data.title}</a></h3>
            <p>{featured.data.description}</p>
            <a href={`${base}articles/${featured.id}/`} class="story-link">Read the field note <span>→</span></a>
          </div>
        </article>
        <aside class="recent-notes">
          <div class="recent-heading"><span>Recent notes</span><small>{String(articles.length).padStart(2, "0")} published</small></div>
          {recent.length ? recent.map((article) => (
            <a href={`${base}articles/${article.id}/`}><small>{article.data.category}</small><strong>{article.data.title}</strong><span>{article.data.readingTime ?? getReadingTime(article.body ?? "")} →</span></a>
          )) : <div class="next-note"><small>THE NEXT NOTE</small><strong>More practical writing is being prepared.</strong><p>Follow the publication to receive the next article automatically.</p><a href={`${base}subscribe/`}>Choose how to follow ↗</a></div>}
        </aside>
      </div>
    )}
  </section>

  <section class="section training-preview shell reveal">
    <div class="training-preview-copy">
      <span class="section-label">Professional training</span>
      <h2>Practical .NET and Azure training shaped by real engineering work.</h2>
      <p>I help developers and teams strengthen fundamentals, understand production patterns, and connect individual technologies to the wider system.</p>
      <div class="training-topics"><span>C# &amp; .NET</span><span>ASP.NET Core</span><span>Azure</span><span>Architecture foundations</span></div>
      <div class="training-actions"><a class="button button-primary" href={`${base}training/`}>Explore training <span>→</span></a><a class="text-button dark-link" href="mailto:suryatechcodex@gmail.com?subject=Training%20enquiry%20-%20Surya%20Tech%20Codex">Discuss a training need ↗</a></div>
    </div>
    <div class="learning-loop" aria-label="Learn, share, write, and train">
      <span>01 <strong>Learn</strong><small>Keep knowledge current</small></span>
      <span>02 <strong>Share</strong><small>Help the community</small></span>
      <span>03 <strong>Write</strong><small>Make learning reusable</small></span>
      <span>04 <strong>Train</strong><small>Help others apply it</small></span>
    </div>
  </section>

  <section class="section project-spotlight shell reveal">
    <div class="project-copy">
      <span class="section-label">Currently building</span>
      <div class="status-line"><span class="live-dot"></span> FLAGSHIP PROJECT · IN PROGRESS</div>
      <h2>JanMitra AI</h2>
      <p>An enterprise AI platform exploring how Azure AI, .NET, search, document intelligence, and agents can make citizen services easier to understand and access.</p>
      <ul><li>Clean Architecture</li><li>Security first</li><li>Cost aware</li><li>Portfolio in public</li></ul>
      <a class="button button-dark" href={`${base}projects/`}>Explore the project <span>→</span></a>
    </div>
    <div class="architecture-window" aria-label="JanMitra AI architecture preview">
      <div class="window-bar"><span></span><span></span><span></span><small>janmitra-ai / architecture</small></div>
      <div class="architecture-flow animated-flow">
        <div class="flow-node user-node"><small>EXPERIENCE</small><strong>Web · Voice</strong></div>
        <i>→</i><div class="flow-node api-node"><small>PLATFORM</small><strong>ASP.NET Core</strong></div>
        <i>→</i><div class="flow-node ai-node"><small>INTELLIGENCE</small><strong>Azure AI</strong></div>
      </div>
      <div class="architecture-caption"><span>DECISION LOG</span><p>Why this design? What are the trade-offs? How will it scale responsibly?</p></div>
    </div>
  </section>

  <section class="career-note reveal">
    <div class="shell career-note-grid">
      <div><span class="section-label">The journey</span><blockquote>“Becoming an architect is not a title change. It is learning to see the whole system.”</blockquote></div>
      <div><p>I’m documenting the transition from experienced full-stack engineer to AI-focused solution architect—the learning, interviews, architecture decisions, and product work behind it.</p><a href={`${base}career/`} class="text-button">Follow the architect journey →</a></div>
    </div>
  </section>

  <section class="shell home-subscribe"><Subscribe /></section>
</BaseLayout>

<script>
  const setupReveal = () => {
    const items = document.querySelectorAll<HTMLElement>(".reveal:not(.is-visible)");
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      items.forEach((item) => item.classList.add("is-visible"));
      return;
    }
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add("is-visible");
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.12 });
    items.forEach((item) => observer.observe(item));
  };
  setupReveal();
  document.addEventListener("astro:page-load", setupReveal);
</script>
