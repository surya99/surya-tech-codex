---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ReadingProgress from "../../components/ReadingProgress.astro";
import ShareBar from "../../components/ShareBar.astro";
import Comments from "../../components/Comments.astro";
import Subscribe from "../../components/Subscribe.astro";
import { getReadingTime } from "../../utils/readingTime";

export async function getStaticPaths() {
  const articles = await getCollection("articles", ({ data }) => !data.draft);
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}

const { article } = Astro.props;
const { Content, headings } = await render(article);
const allArticles = (await getCollection("articles", ({ data }) => !data.draft))
  .filter((candidate) => candidate.id !== article.id);
const related = allArticles
  .map((candidate) => ({
    article: candidate,
    score:
      (candidate.data.category === article.data.category ? 3 : 0) +
      candidate.data.tags.filter((tag) => article.data.tags.includes(tag)).length,
  }))
  .sort((a, b) => b.score - a.score || b.article.data.publishedDate.valueOf() - a.article.data.publishedDate.valueOf())
  .slice(0, 3)
  .map((item) => item.article);
const readingTime = article.data.readingTime ?? getReadingTime(article.body ?? "");
const published = article.data.publishedDate.toISOString();
const modified = (article.data.updatedDate ?? article.data.publishedDate).toISOString();
const articleUrl = new URL(Astro.url.pathname, Astro.site);
const schema = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: article.data.title,
  description: article.data.description,
  datePublished: published,
  dateModified: modified,
  author: { "@type": "Person", name: "Suryakant", url: "https://github.com/surya99" },
  publisher: { "@type": "Organization", name: "Surya Tech Codex" },
  mainEntityOfPage: articleUrl.toString(),
  keywords: article.data.tags.join(", "),
};
---
<BaseLayout title={article.data.title} description={article.data.description}>
  <ReadingProgress />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  <article class="post shell">
    <header class="post-header">
      <a class="back-link" href={`${import.meta.env.BASE_URL}articles/`}>← All articles</a>
      <div class="article-meta"><span>{article.data.category}</span><time datetime={published}>{article.data.publishedDate.toLocaleDateString("en-GB", { day: "2-digit", month: "long", year: "numeric" })}</time><span class="reading-time">{readingTime}</span></div>
      <h1>{article.data.title}</h1>
      <p>{article.data.description}</p>
      <div class="tag-row">{article.data.tags.map((tag) => <span>#{tag}</span>)}</div>
      <div class="author-line">
        <img src="https://avatars.githubusercontent.com/u/11807962?v=4" alt="Suryakant" width="48" height="48" />
        <div><strong>Suryakant</strong><span>.NET + AI Architect · Writing from practical experience</span></div>
      </div>
    </header>
    <div class="article-shell">
      <ShareBar title={article.data.title} url={articleUrl} />
      <div class="prose"><Content /></div>
      {headings.length > 1 && (
        <aside class="table-of-contents" aria-label="Table of contents">
          <span>On this page</span>
          {headings.filter((heading) => heading.depth <= 3).map((heading) => <a href={`#${heading.slug}`} class={`depth-${heading.depth}`}>{heading.text}</a>)}
        </aside>
      )}
    </div>
    <div class="article-takeaway">
      <span>Continue the conversation</span>
      <h2>Did this solve the problem differently in your application?</h2>
      <p>Share the article with your team, or leave a focused question when discussions are enabled.</p>
    </div>
    {related.length > 0 && (
      <section class="related-articles" aria-labelledby="related-title">
        <span class="kicker">Keep exploring</span>
        <h2 id="related-title">Related field notes</h2>
        <div>
          {related.map((item) => (
            <a href={`${import.meta.env.BASE_URL}articles/${item.id}/`}>
              <span>{item.data.category}</span><strong>{item.data.title}</strong><b>Read next →</b>
            </a>
          ))}
        </div>
      </section>
    )}
    <Subscribe compact />
    <Comments />
  </article>
</BaseLayout>
